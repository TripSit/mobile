{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {}
    },
    "development": {
      "developmentClient": true,
      "env": {}
    },
    "internal": {
      "distribution": "internal",
      "env": {}
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {},
      "autoIncrement": true
    }
  }
}
